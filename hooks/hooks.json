{
  "description": "agentsmd hook registration manifest. The installer MERGES these entries into ~/.codex/hooks.json while managing ONLY agentsmd's own entries (identified by the active CODEX_HOME/agentsmd install-dir marker in each command), preserving every other tenant and working whether or not the file pre-exists. Install = strip-own + preserve-all-others + append-own (idempotent); uninstall = strip-own + preserve-others. The installer replaces __AGENTSMD_HOOKS_DIR__ with the absolute install path and shell-escapes it for the command strings. Event names + entry shape match the Codex native hook contract (requires config.toml features.hooks=true on Codex 0.142+ — the installer sets it and migrates a legacy features.codex_hooks flag to the new name). matcher 'Bash' scopes PreToolUse to Bash calls; SessionStart matcher 'startup|resume|clear|compact' covers every Codex context-rehydration source.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/session-start-check.sh\"", "timeout": 5, "additionalContextLimit": 6000 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/pre-bash-safety-check.sh\"", "timeout": 3 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/banned-vocab-check.sh\"", "timeout": 3 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/ship-baseline-check.sh\"", "timeout": 8 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/memory-read-check.sh\"", "timeout": 3 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/secrets-scan.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/pre-mutation-journal.sh\"", "timeout": 3 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|update_plan",
        "hooks": [
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/post-tool-journal.sh\"", "timeout": 3 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/surface-advisories.sh\"", "timeout": 3, "additionalContextLimit": 1000 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/memory-prompt-hint.sh\"", "timeout": 3, "additionalContextLimit": 1000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/residue-audit.sh\"", "timeout": 3 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/sandbox-disposal-check.sh\"", "timeout": 3 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/transcript-structure-scan.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/convention-cite-scan.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/session-exit-checkpoint.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/mem-audit.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"__AGENTSMD_HOOKS_DIR__/session-summary.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
