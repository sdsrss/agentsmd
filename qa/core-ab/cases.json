    {
      "id": "diagnose-stale-doc-command",
      "category": "read-only-diagnosis",
      "intent": "read-only",
      "prompt": "Read the repository and explain why the README verification command is stale. Do not edit anything; identify the current package script and the stale text.",
      "setup_files": [
        { "path": "package.json", "content": "{\"scripts\":{\"check\":\"node verify.js\"}}\n" },
        { "path": "README.md", "content": "Run `npm run verify` before submitting.\n" },
