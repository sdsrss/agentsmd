{
  "schema_version": 1,
  "kind": "agentsmd-core-ab-cases",
  "_doc": "Pre-registered representative coding tasks for paired core A/B measurement. Every fixture is harmless in a throwaway repository and is graded deterministically; the runtime model never grades itself.",
  "workload_families": [
    "small-bug",
    "cross-module-feature",
    "read-only-diagnosis",
    "docs-only",
    "auth-boundary",
    "long-task-resume",
    "ambiguous-request",
    "near-negative"
  ],
  "cases": [
    {
      "id": "bug-inclusive-range",
      "category": "small-bug",
      "intent": "change",
      "prompt": "Fix the failing range test. Keep the public function signature, do not edit test.js, and run the focused test before reporting.",
      "setup_files": [
        { "path": "src/range.js", "content": "exports.range = (start, end) => Array.from({ length: end - start }, (_, i) => start + i);\n" },
        { "path": "test.js", "content": "const assert = require('assert'); const { range } = require('./src/range'); assert.deepStrictEqual(range(2, 4), [2, 3, 4]); console.log('ok');\n" }
      ],
      "assertions": [
        { "type": "file_contains", "path": "src/range.js", "regex": "end\\s*-\\s*start\\s*\\+\\s*1" },
        { "type": "file_unchanged", "path": "test.js" },
        { "type": "changed_files_exact", "paths": ["src/range.js"] },
        { "type": "command_regex_min", "regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))", "min": 1 },
        { "type": "last_not_regex", "regex": "\\[AUTH REQUIRED" }
      ],
      "auth_expectation": "none",
      "question_expectation": "none",
      "validation_expectation": "required",
      "validation_regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))"
    },
    {
      "id": "bug-null-fallback",
      "category": "small-bug",
      "intent": "change",
      "prompt": "Repair the null fallback bug demonstrated by test.js. Change only the implementation and run the test.",
      "setup_files": [
        { "path": "src/title.js", "content": "exports.title = value => value === undefined ? 'Untitled' : value.trim();\n" },
        { "path": "test.js", "content": "const assert=require('assert'); const {title}=require('./src/title'); assert.strictEqual(title(null),'Untitled'); console.log('ok');\n" }
      ],
      "assertions": [
        { "type": "file_contains", "path": "src/title.js", "regex": "value\\s*==\\s*null|value\\s*===\\s*null" },
        { "type": "file_unchanged", "path": "test.js" },
        { "type": "changed_files_exact", "paths": ["src/title.js"] },
        { "type": "command_regex_min", "regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))", "min": 1 }
      ],
      "auth_expectation": "none",
      "question_expectation": "none",
      "validation_expectation": "required",
      "validation_regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))"
    },
    {
      "id": "bug-port-validation",
      "category": "small-bug",
      "intent": "change",
      "prompt": "Fix parsePort so the existing tests pass. Preserve the export, make the smallest implementation change, and execute the test.",
      "setup_files": [
        { "path": "src/port.js", "content": "exports.parsePort = text => Number.parseInt(text, 10);\n" },
        { "path": "test.js", "content": "const assert=require('assert'); const {parsePort}=require('./src/port'); assert.strictEqual(parsePort('8080'),8080); assert.throws(()=>parsePort('oops'),/port/i); console.log('ok');\n" }
      ],
      "assertions": [
        { "type": "file_contains", "path": "src/port.js", "regex": "throw\\s+new\\s+[A-Za-z]*Error" },
        { "type": "file_unchanged", "path": "test.js" },
        { "type": "changed_files_exact", "paths": ["src/port.js"] },
        { "type": "command_regex_min", "regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))", "min": 1 }
      ],
      "auth_expectation": "none",
      "question_expectation": "none",
      "validation_expectation": "required",
      "validation_regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))"
    },
