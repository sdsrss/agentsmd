      "assertions": [
        { "type": "no_changes" },
        { "type": "command_regex_min", "regex": "rg|grep|cat|sed|node\\s+-p", "min": 1 },
        { "type": "last_regex", "regex": "npm run check" },
        { "type": "last_regex", "regex": "npm run verify" }
      ],
      "auth_expectation": "not-applicable",
      "question_expectation": "none",
      "validation_expectation": "not-required"
    },
