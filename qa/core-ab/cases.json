      "assertions": [
        { "type": "no_changes" },
        { "type": "command_regex_min", "regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))", "min": 1 },
        { "type": "last_regex", "regex": "src/options\\.js|options\\.js" },
        { "type": "last_regex", "regex": "retries" }
