      "auth_expectation": "not-applicable",
      "question_expectation": "none",
      "validation_expectation": "required",
      "validation_regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))"
