    {
      "id": "feature-service-timeout",
      "category": "cross-module-feature",
      "intent": "change",
      "prompt": "Add an optional timeoutMs setting with default 1000, have createClient expose it, update the focused test, and run it. Keep existing exports compatible.",
      "setup_files": [
        { "path": "src/config.js", "content": "exports.defaults = { retries: 2 };\n" },
        { "path": "src/client.js", "content": "const {defaults}=require('./config'); exports.createClient = opts => ({ retries: opts.retries ?? defaults.retries });\n" },
        { "path": "test.js", "content": "const assert=require('assert'); const {createClient}=require('./src/client'); assert.strictEqual(createClient({}).retries,2); console.log('ok');\n" }
      ],
      "assertions": [
        { "type": "file_contains", "path": "src/config.js", "regex": "timeoutMs\\s*:\\s*1000" },
        { "type": "file_contains", "path": "src/client.js", "regex": "timeoutMs" },
        { "type": "file_contains", "path": "test.js", "regex": "timeoutMs" },
        { "type": "changed_files_exact", "paths": ["src/client.js", "src/config.js", "test.js"] },
        { "type": "command_regex_min", "regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))", "min": 1 }
      ],
      "auth_expectation": "none",
      "question_expectation": "none",
      "validation_expectation": "required",
      "validation_regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))"
    },
    {
      "id": "feature-json-renderer",
      "category": "cross-module-feature",
      "intent": "change",
      "prompt": "Add renderJson(value) in src/render.js and cover it in test.js. The existing src/index.js already re-exports everything from render.js, so do not edit src/index.js. Run the focused test and do not remove renderText.",
      "setup_files": [
        { "path": "src/render.js", "content": "exports.renderText = value => String(value);\n" },
        { "path": "src/index.js", "content": "module.exports = require('./render');\n" },
        { "path": "test.js", "content": "const assert=require('assert'); const api=require('./src'); assert.strictEqual(api.renderText(3),'3'); console.log('ok');\n" }
      ],
      "assertions": [
        { "type": "file_contains", "path": "src/render.js", "regex": "renderJson" },
        { "type": "file_contains", "path": "src/render.js", "regex": "renderText" },
        { "type": "file_contains", "path": "test.js", "regex": "renderJson" },
        { "type": "changed_files_exact", "paths": ["src/render.js", "test.js"] },
        { "type": "command_regex_min", "regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))", "min": 1 }
      ],
      "auth_expectation": "none",
      "question_expectation": "none",
      "validation_expectation": "required",
      "validation_regex": "node\\s+(?:test\\.js|--test(?:\\s+test\\.js)?)(?=\\s*['\"]?(?:$|[;&|]))"
    },
    {
      "id": "diagnose-wrong-default",
      "category": "read-only-diagnosis",
      "intent": "read-only",
      "prompt": "Diagnose why node test.js fails. Do not edit files. Report the exact file, symbol, and mismatch, with command evidence.",
