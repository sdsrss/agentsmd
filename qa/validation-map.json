  "routes": [
    {
      "id": "automation-recipes",
      "patterns": [
        "automation/**"
      ],
      "risk_categories": [
        "automation-recipe",
        "package-contract"
      ],
      "checks": [
        "workflow-static",
        "distribution"
      ],
      "reason": "Distributed automation recipes must preserve worktree, authorization, and package boundaries.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "codex-review-policy",
      "patterns": [
        ".github/codex/**"
      ],
      "risk_categories": [
        "ci-config",
        "llm-routing"
      ],
      "checks": [
        "workflow-static"
      ],
      "reason": "Codex review prompts are LLM-visible CI policy and must retain the trusted-actor, read-only, and untrusted-input review contract.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "workflow-release",
      "patterns": [
        ".github/workflows/**"
      ],
      "risk_categories": [
        "ci-config",
        "release"
      ],
      "checks": [
        "workflow-static",
        "release-dry-run"
      ],
      "reason": "CI and release workflow changes require static validation and a non-publishing package dry run.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "spec-source",
      "patterns": [
        "spec/source/**"
      ],
      "risk_categories": [
        "spec-source",
        "shared-contract"
      ],
      "checks": [
        "spec-check",
        "drift",
        "hard-rules",
        "conformance-structure"
      ],
      "reason": "Canonical spec source changes fan out to generated and runtime contracts.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "spec-artifact",
      "patterns": [
        "spec/**"
      ],
      "risk_categories": [
        "spec-artifact",
        "shared-contract"
      ],
      "checks": [
        "spec-check",
        "drift",
        "hard-rules"
      ],
      "reason": "Spec artifacts are shared contracts and must stay synchronized.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "native-hook",
      "patterns": [
        "hooks/**",
        "hooks.json"
      ],
      "risk_categories": [
        "native-hook",
        "shared-runtime"
      ],
      "checks": [
        "hook-smoke",
        "shellcheck",
        "safety-coverage",
        "perf-slo",
        "runtime-canary"
      ],
      "reason": "Native hook changes affect safety coverage, shell portability, latency, and live runtime compatibility.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "command-parser-contract",
      "patterns": [
        "hooks/lib/command-parse.js",
        "scripts/tests/command-parse-property.test.js"
      ],
      "risk_categories": [
        "command-parser",
        "shared-runtime"
      ],
      "checks": [
        "command-parse-property"
      ],
      "reason": "Command-parser changes require replayable positive/near-negative metamorphic cases plus explicit crash, timeout, input-size, and recursion bounds.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "doctor-diagnostics",
      "patterns": [
        "scripts/doctor.js",
        "scripts/lib/doctor-plugin.js",
        "scripts/tests/doctor-plugin.test.js",
        "scripts/tests/plugin-surface.test.js"
      ],
      "risk_categories": [
        "diagnostics",
        "shared-runtime"
      ],
      "checks": [
        "doctor-plugin",
        "plugin-surface",
        "install"
      ],
      "reason": "Doctor diagnostics must preserve pure phase mapping, public plugin-surface results, and standalone install health before the full gate widens coverage.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "lifecycle",
      "patterns": [
        "scripts/install.js",
        "scripts/preflight.js",
        "scripts/repair.js",
        "scripts/uninstall.js",
        "scripts/lib/repair-classification.js",
        "scripts/tests/repair-classification.test.js",
        "scripts/lib/lifecycle-journal.js",
        "scripts/lib/lifecycle-lock.js"
      ],
      "risk_categories": [
        "lifecycle",
        "shared-runtime"
      ],
      "checks": [
        "repair-classification",
        "install",
        "preflight",
        "fault-injection",
        "repair",
        "distribution"
      ],
      "reason": "Lifecycle planning or mutation paths require classification, transaction, repair, fault, and distribution evidence.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "core-ab-contract",
      "patterns": [
        "qa/core-ab-eval.js",
        "qa/core-ab/**",
        "qa/conformance/cases.json",
        "schemas/core-ab-cases.schema.json",
        "schemas/core-ab-results.schema.json",
        "scripts/tests/core-ab.test.js"
      ],
      "risk_categories": [
        "core-ab-contract",
        "model-measurement"
      ],
      "checks": [
        "core-ab-structure",
        "argv-lint"
      ],
      "reason": "Paired core evaluation changes must preserve the representative matrix and exact auth-guard conformance adapters, paired isolation, deterministic grading, strict argv, measurement provenance, and zero-model structural gates.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "runtime-canary-contract",
      "patterns": [
        "qa/runtime-canary.js",
        "qa/event-journal-runtime-canary.js",
        "schemas/runtime-canary.schema.json"
      ],
      "risk_categories": [
        "runtime-canary-contract",
        "external-runtime"
      ],
      "checks": [
        "runtime-canary-unit",
        "event-runtime-canary-unit",
        "workflow-static",
        "runtime-canary"
      ],
      "reason": "Runtime canary changes require deterministic dual-scenario grading, workflow boundaries, and a report-only real-runtime observation.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "conformance-evidence-contract",
      "patterns": [
        "scripts/conformance-evidence.js",
        "scripts/conformance-candidate.js",
        "scripts/conformance-binding.js",
        "scripts/lib/conformance-evidence.js",
        "scripts/lib/release-artifact.js",
        "scripts/tests/conformance-evidence.test.js",
        "scripts/tests/conformance-binding.test.js",
        "schemas/conformance-release-evidence.schema.json",
        "schemas/conformance-candidate-attestation.schema.json",
        "schemas/conformance-release-binding.schema.json",
        "qa/conformance/releases/**"
      ],
      "risk_categories": [
        "conformance-evidence-contract",
        "release-evidence",
        "measurement-semantics"
      ],
      "checks": [
        "conformance-evidence",
        "conformance-binding",
        "scorecard-unit",
        "argv-lint",
        "distribution"
      ],
      "reason": "Conformance evidence changes must preserve bounded privacy-safe summaries, exact candidate and artifact identity, strict argv, replay/tamper rejection, scorecard provenance, and distributed behavior.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "reviewed-outcomes-contract",
      "patterns": [
        "hooks/lib/rule-hits.sh",
        "hooks/tests/smoke.sh",
        "scripts/outcomes.js",
        "scripts/lib/outcomes.js",
        "scripts/tests/outcomes.test.js",
        "schemas/reviewed-outcomes.schema.json"
      ],
      "risk_categories": [
        "reviewed-outcomes-contract",
        "measurement-semantics",
        "telemetry-contract"
      ],
      "checks": [
        "outcomes-unit",
        "scorecard-unit",
        "hook-smoke",
        "argv-lint",
        "distribution"
      ],
      "reason": "Reviewed outcome changes must preserve exact blocking-event identity, bounded private review history, explicit denominator exclusions, strict argv, hook parity, and distributed behavior.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "scorecard-contract",
      "patterns": [
        "scripts/scorecard.js",
        "scripts/lib/scorecard.js",
        "schemas/scorecard.schema.json"
      ],
      "risk_categories": [
        "scorecard-contract",
        "measurement-semantics"
      ],
      "checks": [
        "scorecard-unit",
        "argv-lint",
        "distribution"
      ],
      "reason": "Scorecard changes must preserve bounded schema, measurement limits, strict argv, and installed behavior.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "coverage-observation",
      "patterns": [
        "scripts/coverage-observe.js",
        "scripts/tests/coverage-observe.test.js"
      ],
      "risk_categories": [
        "quality-observation",
        "tooling"
      ],
      "checks": [
        "coverage-observe"
      ],
      "reason": "Coverage observation changes must preserve bounded capture parsing, subprocess deduplication, explicit measurement limits, and exact temporary-workspace cleanup.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "js-syntax-compatibility",
      "patterns": [
        "scripts/js-syntax-check.js",
        "scripts/tests/js-syntax-check.test.js"
      ],
      "risk_categories": [
        "runtime-compatibility",
        "static-analysis",
        "tooling"
      ],
      "checks": [
        "js-syntax"
      ],
      "reason": "The all-JavaScript syntax gate must keep bounded file discovery, symlink exclusion, parser timeouts, relative diagnostics, and current-runtime repository coverage.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "skill-metadata",
      "patterns": [
        "skills/**"
      ],
      "risk_categories": [
        "skill-metadata",
        "llm-routing"
      ],
      "checks": [
        "skill-frontmatter",
        "skill-routing",
        "distribution"
      ],
      "reason": "Skill metadata changes alter LLM-visible routing and the installed package surface.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "automation-schema",
      "patterns": [
        "schemas/**"
      ],
      "risk_categories": [
        "automation-contract",
        "shared-contract"
      ],
      "checks": [
        "task-contract",
        "validation-router",
        "distribution"
      ],
      "reason": "Versioned automation schemas are exported contracts.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "validation-map",
      "patterns": [
        "qa/validation-map.json",
        "qa/validation-router-cases.json"
      ],
      "risk_categories": [
        "validation-policy",
        "shared-contract"
      ],
      "checks": [
        "validation-router",
        "distribution"
      ],
      "reason": "Validation policy changes must prove selection, widening, and package availability.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "public-cli",
      "patterns": [
        "bin/**"
      ],
      "risk_categories": [
        "public-cli",
        "shared-contract"
      ],
      "checks": [
        "argv-lint",
        "distribution"
      ],
      "reason": "Public CLI changes require strict argv and installed-distribution coverage.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "package-release",
      "patterns": [
        "package.json",
        "CHANGELOG.md",
        "install.sh",
        ".codex-plugin/**",
        ".agents/**",
        "scripts/version-sync.js"
      ],
      "risk_categories": [
        "package-config",
        "release"
      ],
      "checks": [
        "distribution",
        "release-dry-run"
      ],
      "reason": "Package and release surfaces cannot bypass the full gate or dry-run artifact inspection.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "security-support-policy",
      "patterns": [
        "SECURITY.md",
        "package.json",
        "scripts/security-policy-check.js",
        "scripts/tests/security-policy-check.test.js"
      ],
      "risk_categories": [
        "public-security-policy",
        "shared-contract"
      ],
      "checks": [
        "security-policy",
        "distribution",
        "release-dry-run"
      ],
      "reason": "The published security-support major must match the package major and remain present in the npm artifact.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "quality-assurance",
      "patterns": [
        "qa/**"
      ],
      "risk_categories": [
        "qa-contract"
      ],
      "checks": [
        "validation-router"
      ],
      "reason": "QA contracts require router self-tests and a full regression gate.",
      "requires_full": true,
      "auth_boundary": false
    },
    {
      "id": "documentation",
      "patterns": [
        "docs/**",
        "README.md",
        "README.zh-CN.md",
        "ARCHITECTURE.md",
        "SECURITY.md"
      ],
      "risk_categories": [
        "documentation"
      ],
      "checks": [
        "docs-static"
      ],
      "reason": "Documentation-only changes use the repository drift/document checks.",
      "requires_full": false,
      "auth_boundary": false
    },
    {
      "id": "contributor-instructions",
      "patterns": [
        "AGENTS.md",
        "hooks/AGENTS.md",
        "qa/AGENTS.md",
        "scripts/AGENTS.md"
      ],
      "risk_categories": [
        "contributor-instructions",
        "llm-routing"
      ],
      "checks": [
        "contributor-instructions"
      ],
      "reason": "Contributor instruction changes alter repository-local agent behavior.",
      "requires_full": true,
      "auth_boundary": true
    },
    {
      "id": "script",
      "patterns": [
        "scripts/**"
      ],
      "risk_categories": [
        "script"
      ],
      "checks": [
