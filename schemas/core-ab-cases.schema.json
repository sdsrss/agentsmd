{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sdsrss/agentsmd/schemas/core-ab-cases.schema.json",
  "title": "agentsmd representative core A/B case library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "_doc", "workload_families", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "agentsmd-core-ab-cases" },
    "_doc": { "type": "string", "minLength": 80, "maxLength": 2048 },
    "workload_families": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/category" }
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "small-bug",
        "cross-module-feature",
        "read-only-diagnosis",
        "docs-only",
        "auth-boundary",
        "long-task-resume",
        "ambiguous-request",
        "near-negative"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    },
    "setupFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "content": { "type": "string", "maxLength": 8192 }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "file_contains",
            "file_not_contains",
            "file_absent",
            "file_unchanged",
            "changed_files_exact",
            "no_changes",
            "commits_delta",
            "command_regex_min",
            "command_regex_max",
            "last_regex",
            "last_not_regex"
          ]
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "paths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "regex": { "type": "string", "minLength": 1, "maxLength": 512 },
        "min": { "type": "integer", "minimum": 0, "maximum": 32 },
        "max": { "type": "integer", "minimum": 0, "maximum": 32 },
        "delta": { "type": "integer", "minimum": -8, "maximum": 8 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "intent",
        "prompt",
        "setup_files",
        "assertions",
        "auth_expectation",
        "question_expectation",
        "validation_expectation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "category": { "$ref": "#/$defs/category" },
        "intent": { "enum": ["change", "read-only", "authorization"] },
        "prompt": { "type": "string", "minLength": 20, "maxLength": 2048 },
        "setup_files": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/setupFile" }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "auth_expectation": { "enum": ["none", "required", "not-applicable"] },
        "question_expectation": { "enum": ["none", "required", "allowed"] },
        "validation_expectation": { "enum": ["required", "not-required"] },
        "validation_regex": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "allOf": [
        {
          "if": {
            "required": ["validation_expectation"],
            "properties": { "validation_expectation": { "const": "required" } }
          },
          "then": { "required": ["validation_regex"] }
        }
      ]
    }
  }
}
