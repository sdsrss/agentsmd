{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sdsrss/agentsmd/schemas/core-ab-results.schema.json",
  "title": "agentsmd representative core A/B result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "captured_at", "runtime", "experiment", "rows", "aggregate", "limits"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "agentsmd-core-ab-result" },
    "captured_at": { "$ref": "#/$defs/text" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex_version", "model"],
      "properties": {
        "codex_version": { "$ref": "#/$defs/text" },
        "model": { "$ref": "#/$defs/text" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "case_library_sha256", "canonical_core_sha256", "extended_sha256", "candidate_core_sha256", "conditions", "case_count"],
      "properties": {
        "seed": { "$ref": "#/$defs/text" },
        "case_library_sha256": { "$ref": "#/$defs/sha" },
        "canonical_core_sha256": { "$ref": "#/$defs/sha" },
        "extended_sha256": { "$ref": "#/$defs/sha" },
        "candidate_core_sha256": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "conditions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["current-core", "no-core", "candidate-core"] }
        },
        "case_count": { "type": "integer", "minimum": 1, "maximum": 40 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 80,
      "items": { "$ref": "#/$defs/row" }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "current-core": { "$ref": "#/$defs/aggregateSummary" },
        "no-core": { "$ref": "#/$defs/aggregateSummary" },
        "candidate-core": { "$ref": "#/$defs/aggregateSummary" }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/longText" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "longText": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonnegative": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "nullableNonnegative": {
      "oneOf": [
        { "$ref": "#/$defs/nonnegative" },
        { "type": "null" }
      ]
    },
    "aggregateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells", "passed", "failed", "infra_errors", "token_state", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "wall_ms"],
      "properties": {
        "cells": { "$ref": "#/$defs/nonnegative" },
        "passed": { "$ref": "#/$defs/nonnegative" },
        "failed": { "$ref": "#/$defs/nonnegative" },
        "infra_errors": { "$ref": "#/$defs/nonnegative" },
        "token_state": { "enum": ["measured", "partial", "unavailable"] },
        "input_tokens": { "$ref": "#/$defs/nullableNonnegative" },
        "cached_input_tokens": { "$ref": "#/$defs/nullableNonnegative" },
        "output_tokens": { "$ref": "#/$defs/nullableNonnegative" },
        "reasoning_output_tokens": { "$ref": "#/$defs/nullableNonnegative" },
        "wall_ms": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "case_id", "category", "condition", "order_index", "condition_core_sha256", "status", "task_success", "assertion_failures", "metrics", "human_preference", "capture"],
      "properties": {
        "pair_id": { "$ref": "#/$defs/text" },
        "case_id": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "condition": { "enum": ["current-core", "no-core", "candidate-core"] },
        "order_index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "condition_core_sha256": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "status": { "enum": ["pass", "fail", "infra-error"] },
        "task_success": { "type": "boolean" },
        "assertion_failures": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/longText" }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unnecessary_ask", "auth_false_positive", "auth_false_negative", "fresh_evidence_violation", "command_executions", "turns", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "wall_ms"],
          "properties": {
            "unnecessary_ask": { "type": "boolean" },
            "auth_false_positive": { "type": "boolean" },
            "auth_false_negative": { "type": "boolean" },
            "fresh_evidence_violation": { "type": "boolean" },
            "command_executions": { "$ref": "#/$defs/nonnegative" },
            "turns": { "$ref": "#/$defs/nonnegative" },
            "input_tokens": { "$ref": "#/$defs/nullableNonnegative" },
            "cached_input_tokens": { "$ref": "#/$defs/nullableNonnegative" },
            "output_tokens": { "$ref": "#/$defs/nullableNonnegative" },
            "reasoning_output_tokens": { "$ref": "#/$defs/nullableNonnegative" },
            "wall_ms": { "$ref": "#/$defs/nonnegative" }
          }
        },
        "human_preference": { "type": "null" },
        "capture": { "$ref": "#/$defs/text" }
      }
    }
  }
}
